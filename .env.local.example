# Project-local environment — copy to .env.local and fill in your values.
# .env.local is gitignored. Read by the Makefile (not your shell).
#
# Required to sign with Developer ID instead of ad-hoc:
DEVELOPER_ID_APP=Developer ID Application: <Your Company> (ABCDE12345)

# Required to notarize. Omit any of these → notarization is skipped,
# the bundle is still Developer-ID signed (just not stapled).
NOTARY_APPLE_ID=you@apple.id
NOTARY_TEAM_ID=ABCDE12345
NOTARY_PASSWORD=xxxx-xxxx-xxxx-xxxx
