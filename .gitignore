# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
.uv-bootstrap/

# Build output
/build/
/dist/
/dist.lock/
/dist-nuitka/
*.spec

# Tooling caches
.pytest_cache/
.ruff_cache/
.idea/

# Project-local env (signing creds, app-specific passwords, …) — never commit
.env.local

# Stemgen working files
input/*
output/*
metadata.part1.json
metadata.part2.json

# Spleeter / Demucs model caches (legacy locations)
pretrained_models/*
demucs/*

# Droplet
stemgen-droplet.app

# macOS
.DS_Store
._*

# Nuitka writes its crash report into the CWD, not dist/
nuitka-crash-report.xml

# setuptools build metadata (uv build / pip install .)
*.egg-info/
